# Environment variables (contains account IDs, ARNs, secrets)
.env

# AgentCore config (generated by deploy.sh, contains account-specific data)
.bedrock_agentcore.yaml

# Gateway config (generated by deploy_gateway.sh, contains account-specific gateway URL)
deployment/devops-agent/gateway_config.json

# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Scan reports
scan-report*.json
new-scan-report*.json

# Deployment log (account-specific)
documentation/deployment-log.md

# OS
.DS_Store
Thumbs.db

# Test staging directory (created during local testing)
_test_stage/

# IDE
.idea/
.vscode/
*.swp
*.swo
*.zip
